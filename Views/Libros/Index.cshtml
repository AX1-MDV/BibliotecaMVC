@model IEnumerable<BibliotecaMVC.Models.Libro>
@{
    ViewData["Title"] = "Catálogo de Libros";
}
<h1>@ViewData["Title"]</h1>

<a asp-action="Crear" class="btn btn-primary mb-3">Crear Nuevo Libro</a>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="row g-0">
                    <div class="col-4">
                        <img src="~/images/@(string.IsNullOrEmpty(libro.ImagePath) ? "placeholder.jpg" : libro.ImagePath)" class="img-fluid rounded-start" alt="@libro.Titulo" />
                    </div>
                    <div class="col-8">
                        <div class="card-body">
                            <h5 class="card-title">@libro.Titulo</h5>
                            <p class="card-text">
                                <strong>Autor:</strong> @libro.Autor<br />
                                <strong>Categoría:</strong> @libro.Categoria<br />
                                <strong>Año:</strong> @libro.AnioPublicacion<br />
                                <strong>Precio:</strong> @libro.Precio.ToString("C")<br />
                            </p>
                            <a asp-action="Detalles" asp-route-id="@libro.Id" class="btn btn-primary">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@libro.Id" class="btn btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@libro.Id" class="btn btn-danger">Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>