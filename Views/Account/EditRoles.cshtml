@model BibliotecaMVC.Models.EditUserRolesViewModel
@{
    ViewData["Title"] = "Editar roles de usuario";
}

<h1>Editar roles: @Model.UserName</h1>

<form asp-action="EditRoles" method="post">
    <input type="hidden" asp-for="UserId" />
    <div class="mb-3">
        @for (int i = 0; i < Model.Roles.Count; i++)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="Roles[@i].Selected" />
                <label class="form-check-label">@Model.Roles[i].RoleName</label>
                <input type="hidden" asp-for="Roles[@i].RoleName" />
            </div>
        }
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Users" class="btn btn-secondary">Cancelar</a>
</form>