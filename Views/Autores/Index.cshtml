@model IEnumerable<BibliotecaMVC.Models.Autor>
@using System.Text.Json
@{
    ViewData["Title"] = "Listado de Autores";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <p>Se encuentran @Model.Count() autores registrados en la base de datos.</p>
    <a asp-action="Crear" class="btn btn-primary mb-3">Crear Nuevo Autor</a>
</div>

<div class="row">
    @foreach (var autor in Model)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card mb-4 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@autor.Nombre @autor.Apellido</h5>
                    <p class="card-subtitle mb-2">
                        <strong>Nacionalidad:</strong> @autor.Nacionalidad<br />
                        <strong>Fecha de Nacimiento:</strong> @autor.FechaNacimiento.ToString("dd/MM/yyyy")<br />
                        <p class="card-text">
                            Edad: @(DateTime.Now.Year - autor.FechaNacimiento.Year)
                        </p>
                        <strong>Activo:</strong>
                        @if (autor.Activo)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No</span>
                        }
                    </p>
                    <div class="mt-auto">
                        <a asp-action="Detalles" asp-route-id="@autor.Id" class="btn btn-primary">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@autor.Id" class="btn btn-warning">Editar</a>
                    </div>
                    <a asp-action="Delete" asp-route-id="@autor.Id" class="btn btn-danger">Eliminar</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        var mensaje = @Html.Raw(JsonSerializer.Serialize(TempData["SuccessMessage"] ?? ""));
        if (mensaje) {
            // SweetAlert
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: mensaje,
                timer: 2000,
                showConfirmButton: false
            });
        }
    </script>
}